# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Run `python -m agent.list_models` to see which model names your key can use.
GEMINI_MODEL=gemini-flash-latest
# NVIDIA Build key (each developer uses their own)
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# Exact model id of Nemotron 3.5 Super VL as listed on build.nvidia.com
NEMOTRON_MODEL=
# Folder that contains the unzipped dataset (the folder with data/ and questions.jsonl)
DATA_DIR=./data/junction-dataset-preview
